# Guardrails (redact) – POST { "text": "..." } → { "redacted": "..." }
GUARDRAILS_URL=http://172.236.141.236:8169/redact

# VirusTotal – IP lookup (x-apikey)
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# Threat Feed API (ip.txt + ipv4.txt, e.g. Taxii 2.x / CloudSEK)
# Example: http://172.104.185.43:8100
THREATFEED_API_URL=http://172.104.185.43:8100
THREATFEED_USER=admin
THREATFEED_PASSWORD=admin123

# Gemini (for IP analysis + free chat when aiProvider=gemini)
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq (when aiProvider=groq)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# OpenRouter (when aiProvider=gemini2.5 – uses Gemini 2.5 Pro)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-pro

# Simple app login (for UI auth)
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=changeme
# Session lifetime in seconds (e.g. 1800 = 30 minutes)
APP_SESSION_MAX_AGE=1800
